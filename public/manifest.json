{
  "manifest_version": 3,
  "name": "PostFlow",
  "short_name": "PostFlow",
  "version": "1.0.0",
  "description": "Free, open-source Chrome extension for sharing to Facebook Groups, WhatsApp Groups, and Messenger. Scheduling, templates, and local-first storage.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PostFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*", "*://*.m.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["content-whatsapp.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": ["*://www.messenger.com/*", "*://messenger.com/*"],
      "js": ["content-messenger.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "options_page": "options.html",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.m.facebook.com/*",
    "*://web.whatsapp.com/*",
    "*://www.messenger.com/*",
    "*://messenger.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": [
        "*://*.facebook.com/*",
        "*://*.m.facebook.com/*",
        "*://web.whatsapp.com/*",
        "*://www.messenger.com/*",
        "*://messenger.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https://*.facebook.com https://*.fbcdn.net https://web.whatsapp.com https://www.messenger.com;"
  },
  "minimum_chrome_version": "88",
  "author": "Community",
  "homepage_url": "https://github.com/hacker-194/postflow",
  "incognito": "split"
}
