{
  "manifest_version": 3,
  "name": "Free Group Poster",
  "short_name": "FGP",
  "version": "1.0.0",
  "description": "Free, open-source Chrome extension for sharing posts to multiple Facebook groups. Advanced features, no tracking, fully local.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Free Group Poster",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*", "*://*.m.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "options_page": "options.html",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.m.facebook.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["*://*.facebook.com/*", "*://*.m.facebook.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https://*.facebook.com https://*.fbcdn.net;"
  },
  "minimum_chrome_version": "88",
  "author": "Community",
  "homepage_url": "https://github.com/free-group-poster/free-group-poster",
    "incognito": "split"
}