{
  "name": "Free Group Poster",
  "short_name": "FGP",
  "description": "Free, open-source Chrome extension for sharing posts to multiple Facebook groups and WhatsApp groups. Built as an alternative to commercial MultiGroupPoster.",
  "version": "1.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Free Group Poster"
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["src/content/index.ts"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["src/content/whatsapp.ts"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://www.messenger.com/*",
        "*://messenger.com/*",
        "*://www.facebook.com/messages/*"
      ],
      "js": ["src/content/messenger.ts"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "permissions": ["storage", "alarms", "notifications", "scripting", "tabs"],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.fbcdn.net/*",
    "*://web.whatsapp.com/*",
    "*://www.messenger.com/*",
    "*://messenger.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": [
        "*://*.facebook.com/*",
        "*://web.whatsapp.com/*",
        "*://www.messenger.com/*",
        "*://messenger.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://*.facebook.com https://*.fbcdn.net https://web.whatsapp.com https://www.messenger.com;"
  },
  "minimum_chrome_version": "88"
}
